# Port the API listens on (Render sets this automatically)
PORT=5000
NODE_ENV=development

# MongoDB connection string (e.g. MongoDB Atlas).
# Leave empty in development to use an automatic in-memory database with demo data.
MONGO_URI=

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed by CORS (or * for any)
CLIENT_URL=http://localhost:5173

# Optional: admin account created on startup if it does not exist
ADMIN_NAME=Retain Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo accounts (demo@retain.app and admin@retain.app) are created automatically on startup.
