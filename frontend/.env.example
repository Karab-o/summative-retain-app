# Base URL of the Retain API, including the /api suffix.
# Leave empty in development: Vite proxies /api to http://localhost:5000.
# Production example: https://retain-api.onrender.com/api
VITE_API_URL=

# ISO 4217 currency code used to display amounts (e.g. USD, EUR, RWF)
VITE_CURRENCY=USD

# Show the demo account shortcuts on the sign-in page (always shown in development)
VITE_SHOW_DEMO_ACCOUNTS=true
